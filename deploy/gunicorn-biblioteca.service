[Unit]
Description=Sistema de Biblioteca Gunicorn
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/sistema-biblioteca
EnvironmentFile=/opt/sistema-biblioteca/.env
ExecStart=/opt/sistema-biblioteca/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8001 config.wsgi:application
Restart=on-failure

[Install]
WantedBy=multi-user.target
